---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LessonCard from '../../components/LessonCard.astro';
import { url } from '../../lib/base';

const entries = await getCollection('lessons');
const lessons = entries
  .map((e) => {
    const stem = e.id.replace(/\.md$/, '');
    return {
      id: stem,
      title:
        e.data.title ??
        stem.replace(/^(Lesson|Part|I+)\s+/i, '').trim(),
      words: (e.body ?? '').split(/\s+/).filter(Boolean).length,
    };
  })
  .sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));

const totalWords = lessons.reduce((s, l) => s + l.words, 0);

// Categorize lessons into modules
const modules = [
  {
    title: 'Module 1: Foundations & Trading Mindset',
    desc: 'Core principles of stock trading, building a winning psychology, and market secrets.',
    filter: (id: string) => ['lesson-1-introduction-to-stock-trading', 'lesson-2-the-secrets-to-consistent-trading-profits', 'lesson-7-psychology-of-winning-traders'].includes(id),
  },
  {
    title: 'Module 2: Technical Analysis & Charting Mechanics',
    desc: 'Candlestick patterns, trendlines, support/resistance, and charting platforms.',
    filter: (id: string) => ['lesson-3-mastering-technical-analysis', 'lesson-4-mastering-technical-analysis-ii', 'lesson-9-charting-brokerage-platform'].includes(id),
  },
  {
    title: 'Module 3: Strategy Systems, Risk Management & Execution',
    desc: 'Position sizing mathematics, the Bounce System, trade planning, and range trading.',
    filter: (id: string) => ['lesson-5-position-sizing', 'lesson-6-stock-swing-trading-system-1-bounce-system', 'lesson-8-developing-a-trading-plan', 'lesson-10-trade-the-range-strategybonus'].includes(id),
  },
];
---
<BaseLayout
  title="Level 1 — Profit Snapper"
  description="Foundational trading course: trading mechanics, technical analysis, position sizing, Bounce System, psychology, and trading plan."
>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-12 pb-10">
    <nav class="text-sm text-slate-500 dark:text-ink-400 mb-6">
      <a href={url('/')} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2 text-slate-300 dark:text-ink-600">/</span>
      <span class="text-slate-900 dark:text-ink-200 font-medium">Level 1</span>
    </nav>
    <div class="max-w-3xl">
      <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-brand-500/10 text-brand-700 dark:text-brand-300 ring-brand-500/30">
        Foundational Curriculum
      </span>
      <h1 class="mt-4 font-display text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Level 1 — <span class="gradient-text">Profit Snapper</span>
      </h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-ink-300 leading-relaxed">
        The complete foundational trading course. {lessons.length} lessons, {totalWords.toLocaleString()} words.
        Organized into 3 core learning modules covering mindset, technical analysis, and strategy execution.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-24 space-y-16">
    {modules.map((mod) => {
      const modLessons = lessons.filter((l) => mod.filter(l.id));
      if (modLessons.length === 0) return null;
      return (
        <div class="space-y-6">
          <div class="border-b border-slate-200/80 dark:border-white/10 pb-4">
            <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-white">{mod.title}</h2>
            <p class="mt-1 text-sm text-slate-600 dark:text-ink-400">{mod.desc}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {modLessons.map((l, i) => (
              <LessonCard
                href={url(`/level-1/${l.id}/`)}
                index={lessons.findIndex((x) => x.id === l.id) + 1}
                title={l.title}
                words={l.words}
                badgeColor="brand"
              />
            ))}
          </div>
        </div>
      );
    })}
  </section>
</BaseLayout>

