---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import ReaderControls from '../../components/ReaderControls.astro';
import { url } from '../../lib/base';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const stem = entry.id.replace(/\.md$/, '');
const title = entry.data.title ?? stem.replace(/^(Lesson|Part|I+)\s+/i, '').trim();
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(words / 230));

const all = await getCollection('lessons');
const sorted = all.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
const idx = sorted.findIndex((e) => e.id === entry.id);
const prev = idx > 0 ? sorted[idx - 1] : null;
const next = idx < sorted.length - 1 ? sorted[idx + 1] : null;

function link(e: typeof entry) {
  return url(`/level-1/${e.id.replace(/\.md$/, '')}/`);
}
function prevTitle(e: typeof entry) {
  return (e.data.title ?? e.id.replace(/\.md$/, '').replace(/^(Lesson|Part|I+)\s+/i, '')).trim();
}
---

<BaseLayout title={title} description={`Lesson: ${title}. ${words.toLocaleString()} words.`}>
  <ProgressBar />

  <div class="mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-10 pt-10 pb-24">
    <div class="xl:grid xl:grid-cols-[minmax(0,1fr)_16rem] xl:gap-12">
      <article class="min-w-0">
        <nav
          class="flex items-center justify-between gap-4 text-sm text-slate-500 dark:text-ink-400 mb-10"
        >
          <div class="flex items-center gap-2">
            <a href={url('/')} class="hover:text-slate-900 dark:hover:text-white transition-colors"
              >Home</a
            >
            <span class="text-slate-300 dark:text-ink-600">/</span>
            <a
              href={url('/level-1/')}
              class="hover:text-slate-900 dark:hover:text-white transition-colors">Level 1</a
            >
          </div>
          <ReaderControls />
        </nav>

        <header class="mx-auto max-w-[656px]">
          <div class="flex flex-wrap items-center gap-2 text-sm">
            <span
              class="inline-flex items-center rounded-full border border-slate-300 dark:border-white/15 bg-white/70 dark:bg-ink-900/60 px-3 py-1 text-slate-600 dark:text-ink-300"
            >
              Level 1
            </span>
            <span
              class="inline-flex items-center rounded-full border border-slate-300 dark:border-white/15 bg-white/70 dark:bg-ink-900/60 px-3 py-1 text-slate-600 dark:text-ink-300"
            >
              Profit Snapper
            </span>
          </div>
          <h1
            class="mt-6 font-display text-[2.625rem] sm:text-[2.625rem] font-bold tracking-[-0.011em] text-slate-900 dark:text-white leading-[1.24]"
          >
            {title}
          </h1>
          <div class="mt-8 flex items-center gap-3 text-base text-slate-600 dark:text-ink-300">
            <span
              class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-700 text-white text-sm font-semibold"
            >
              SC
            </span>
            <a href={url('/')} class="font-semibold text-slate-900 dark:text-white hover:underline"
              >Steven Chen</a
            >
            <span class="text-slate-400 dark:text-ink-500">·</span>
            <span>{readMinutes} min read</span>
            <span class="text-slate-400 dark:text-ink-500">·</span>
            <time>Aug 9, 2026</time>
          </div>
        </header>

        <div
          class="mx-auto max-w-[656px] prose dark:prose-invert mt-12 prose-headings:scroll-mt-nav prose-pre:overflow-x-auto"
        >
          <Content />
        </div>

        <hr class="mx-auto max-w-[656px] mt-16 border-0 border-t hairline" />

        <footer class="mx-auto max-w-[656px] mt-8">
          <div class="flex items-start gap-4">
            <span
              class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-slate-700 text-white text-base font-semibold"
            >
              SC
            </span>
            <div class="flex-1">
              <div
                class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-ink-400"
              >
                Written by
              </div>
              <div class="mt-1 text-base font-semibold text-slate-900 dark:text-white">
                Steven Chen
              </div>
              <p
                class="mt-1 font-serif text-[15px] leading-[1.55] text-slate-600 dark:text-ink-400"
              >
                Trading.Course is a long-form archive of transcribed lessons for serious learners.
                Every setup, rule, and formula preserved in full — no summaries, no skips.
              </p>
            </div>
          </div>
        </footer>

        <nav class="mx-auto max-w-[656px] mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            prev ? (
              <a
                href={link(prev)}
                class="group rounded-md border hairline p-4 transition-colors hover:border-slate-300 dark:hover:border-white/20"
              >
                <span class="text-xs font-semibold text-slate-400 dark:text-ink-500">
                  ← Previous
                </span>
                <p class="mt-1 text-sm font-semibold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-300 transition-colors line-clamp-2">
                  {prevTitle(prev)}
                </p>
              </a>
            ) : (
              <div />
            )
          }
          {
            next ? (
              <a
                href={link(next)}
                class="group rounded-md border hairline p-4 transition-colors text-right hover:border-slate-300 dark:hover:border-white/20"
              >
                <span class="text-xs font-semibold text-slate-400 dark:text-ink-500">Next →</span>
                <p class="mt-1 text-sm font-semibold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-300 transition-colors line-clamp-2">
                  {prevTitle(next)}
                </p>
              </a>
            ) : (
              <div />
            )
          }
        </nav>
      </article>

      <aside>
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>
