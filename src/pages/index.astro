---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LessonCard from '../components/LessonCard.astro';
import { url } from '../lib/base';

const lessons1 = await getCollection('lessons');
const lessons2 = await getCollection('lessons2');

function lessonMeta(entry: {
  id: string;
  data: { title?: string; description?: string };
  body?: string;
}) {
  const stem = entry.id.replace(/\.md$/, '');
  const title = entry.data.title ?? stem.replace(/^(Lesson|Part|I+)\s+/i, '').trim();
  const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
  return { title, words };
}

const l1 = lessons1
  .map((e) => ({ ...lessonMeta(e), id: e.id, data: e.data }))
  .sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
const l2 = lessons2
  .map((e) => ({ ...lessonMeta(e), id: e.id, data: e.data }))
  .sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));

const totalWords = [...l1, ...l2].reduce((s, l) => s + l.words, 0);

const featured = [
  {
    level: 'Level 1',
    title: 'Profit Snapper',
    color: 'brand',
    subtitle:
      'Trading mechanics, technical analysis, position sizing equations, the Bounce System, risk management, and the mindset of consistent winners.',
    href: '/level-1/',
    lessons: l1,
    count: l1.length,
    words: l1.reduce((s, l) => s + l.words, 0),
    accent: 'brand',
  },
  {
    level: 'Level 2',
    title: 'Market Snapper',
    color: 'violet',
    subtitle:
      'Advanced multi-system strategies: trend retracement, breakout systems, Bollinger mean reversion, capitulation setups, divergence, GUNS day-trading, and Slingshot scalping.',
    href: '/level-2/',
    lessons: l2,
    count: l2.length,
    words: l2.reduce((s, l) => s + l.words, 0),
    accent: 'violet',
  },
] as const;

const topicTags = [
  'Bounce System',
  'Position Sizing',
  'Trend Retracement',
  'Breakout Strategy',
  'Bollinger Bands',
  'Capitulation',
  'GUNS Scalp',
  'Slingshot',
];
---

<BaseLayout title="Trading Course">
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <span
        class="inline-flex items-center rounded-full border border-slate-300 dark:border-white/15 bg-white/70 dark:bg-ink-900/60 px-3 py-1 text-slate-600 dark:text-ink-300"
      >
        Trading Course
      </span>
      <span
        class="inline-flex items-center rounded-full border border-slate-300 dark:border-white/15 bg-white/70 dark:bg-ink-900/60 px-3 py-1 text-slate-600 dark:text-ink-300"
      >
        Long-form
      </span>
    </div>
    <h1
      class="mt-6 font-display text-[2.75rem] sm:text-6xl font-bold tracking-[-0.022em] text-slate-900 dark:text-white leading-[1.05]"
    >
      A complete trading course,
      <span class="gradient-text-warm">in your browser.</span>
    </h1>
    <p
      class="mt-5 font-serif text-[1.35rem] leading-[1.55] text-slate-600 dark:text-ink-300 max-w-2xl"
    >
      Two full curricula — Level 1 (Profit Snapper) and Level 2 (Market Snapper) — transcribed from
      original video SRTs. Every setup, rule, and formula preserved in full.
    </p>
    <div class="mt-8 flex items-center gap-3 text-base text-slate-600 dark:text-ink-300">
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-700 text-white text-sm font-semibold"
        >SC</span
      >
      <a href={url('/')} class="font-semibold text-slate-900 dark:text-white hover:underline"
        >Steven Chen</a
      >
      <span class="text-slate-400 dark:text-ink-500">·</span>
      <span class="tabular-nums">{l1.length + l2.length} lessons</span>
      <span class="text-slate-400 dark:text-ink-500">·</span>
      <span class="tabular-nums">{totalWords.toLocaleString()} words</span>
      <span class="text-slate-400 dark:text-ink-500">·</span>
      <time>Aug 9, 2026</time>
    </div>

    <!-- Quick Search Bar in Hero -->
    <div class="mt-8">
      <button
        type="button"
        data-open-search
        class="group w-full max-w-xl flex items-center justify-between rounded-md border border-slate-300 dark:border-white/15 bg-white dark:bg-ink-900/60 px-4 py-3 text-sm text-slate-500 dark:text-ink-400 hover:border-slate-400 dark:hover:border-white/25 transition-colors text-left"
      >
        <span class="flex items-center gap-2.5">
          <svg
            class="h-5 w-5 text-slate-400 group-hover:text-brand-500 transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          Search any strategy, indicator, or concept...
        </span>
        <kbd
          class="hidden sm:inline-block px-2 py-0.5 text-xs font-semibold text-slate-500 dark:text-ink-400 bg-slate-100 dark:bg-ink-800 rounded border border-slate-200 dark:border-white/10"
          >⌘K</kbd
        >
      </button>
    </div>

    <!-- Topic Tags -->
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="text-xs font-medium text-slate-400 dark:text-ink-500 mr-1">Popular topics:</span>
      {
        topicTags.map((tag) => (
          <button
            type="button"
            data-open-search
            data-search-query={tag}
            class="inline-flex items-center rounded-md border border-slate-200 dark:border-white/10 bg-white/60 dark:bg-white/5 px-2.5 py-1 text-xs font-medium text-slate-700 dark:text-ink-300 hover:border-brand-500/50 hover:text-brand-600 dark:hover:text-brand-300 hover:bg-brand-500/5 transition-colors"
          >
            #{tag}
          </button>
        ))
      }
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href={url('/level-1/')}
        class="inline-flex items-center gap-2 rounded-md bg-slate-900 dark:bg-white px-6 py-2.5 text-sm font-semibold text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors"
      >
        Start Level 1 — Profit Snapper
      </a>
      <a
        href={url('/level-2/')}
        class="inline-flex items-center gap-2 rounded-md border border-slate-300 dark:border-white/15 bg-white dark:bg-ink-900/60 px-6 py-2.5 text-sm font-semibold text-slate-800 dark:text-ink-100 hover:bg-slate-50 dark:hover:bg-ink-900 transition-colors"
      >
        Explore Level 2 — Market Snapper
      </a>
    </div>
  </section>

  <hr class="mx-auto max-w-3xl border-0 border-t hairline" />

  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12 space-y-14">
    {
      featured.map((f) => (
        <div>
          <div class="border-b border-slate-200/80 dark:border-white/10 pb-4">
            <div class="inline-flex items-center rounded-full border border-slate-300 dark:border-white/15 bg-white/70 dark:bg-ink-900/60 px-3 py-1 text-sm text-slate-600 dark:text-ink-300">
              {f.level}
            </div>
            <div class="mt-3 flex items-center justify-between gap-4">
              <h2 class="font-display text-[1.875rem] font-bold tracking-[-0.014em] text-slate-900 dark:text-white">
                <a
                  href={url(f.href)}
                  class="hover:text-brand-600 dark:hover:text-brand-300 transition-colors"
                >
                  {f.title}
                </a>
              </h2>
              <a
                href={url(f.href)}
                class="hidden sm:inline-flex items-center gap-1 text-sm font-semibold text-slate-700 dark:text-ink-200 hover:text-brand-600 dark:hover:text-brand-300 transition-colors"
              >
                All lessons →
              </a>
            </div>
          </div>
          <p class="mt-3 font-serif text-[1.0625rem] text-slate-600 dark:text-ink-300 leading-[1.6]">
            {f.subtitle}
          </p>
          <ul class="mt-4 divide-y divide-slate-200/70 dark:divide-white/5">
            {f.lessons.slice(0, 3).map((l) => (
              <li>
                <LessonCard
                  href={url(`${f.href}${l.id}/`)}
                  index={f.lessons.findIndex((x) => x.id === l.id) + 1}
                  title={l.title}
                  words={l.words}
                  badgeColor={f.accent === 'brand' ? 'brand' : 'violet'}
                />
              </li>
            ))}
          </ul>
          <div class="mt-4 flex items-center justify-between text-sm">
            <span class="text-slate-500 dark:text-ink-400 tabular-nums">
              {f.count} lessons · {f.words.toLocaleString()} words
            </span>
            <a
              href={url(f.href)}
              class="font-semibold text-brand-600 dark:text-brand-300 hover:underline"
            >
              See all →
            </a>
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>
