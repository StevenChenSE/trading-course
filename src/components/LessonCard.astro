---
export interface Props {
  href: string;
  index: number;
  title: string;
  description?: string;
  badge?: string;
  badgeColor?: 'brand' | 'violet' | 'emerald' | 'amber';
  words?: number;
}

const { href, index, title, description, badge, badgeColor = 'brand', words } = Astro.props;

const colorMap = {
  brand: {
    bar: 'from-brand-500/30 to-brand-500/0',
    badge: 'bg-brand-500/10 text-brand-700 dark:text-brand-300 ring-brand-500/30',
    text: 'text-brand-600 dark:text-brand-400 group-hover:text-brand-500 dark:group-hover:text-brand-300',
  },
  violet: {
    bar: 'from-violet-500/30 to-violet-500/0',
    badge: 'bg-violet-500/10 text-violet-700 dark:text-violet-300 ring-violet-500/30',
    text: 'text-violet-600 dark:text-violet-400 group-hover:text-violet-500 dark:group-hover:text-violet-300',
  },
  emerald: {
    bar: 'from-emerald-500/30 to-emerald-500/0',
    badge: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 ring-emerald-500/30',
    text: 'text-emerald-600 dark:text-emerald-400 group-hover:text-emerald-500 dark:group-hover:text-emerald-300',
  },
  amber: {
    bar: 'from-amber-500/30 to-amber-500/0',
    badge: 'bg-amber-500/10 text-amber-700 dark:text-amber-300 ring-amber-500/30',
    text: 'text-amber-600 dark:text-amber-400 group-hover:text-amber-500 dark:group-hover:text-amber-300',
  },
};

const colors = colorMap[badgeColor] || colorMap.brand;
---
<a
  href={href}
  class="group relative block rounded-2xl glass glass-hover p-6 transition-all hover:-translate-y-0.5 animate-fade-up"
  style={`animation-delay: ${index * 30}ms`}
>
  <div class={`absolute inset-x-0 top-0 h-px bg-gradient-to-r ${colors.bar}`}></div>
  <div class="flex items-start justify-between gap-3">
    <span class={`inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${colors.badge}`}>
      {badge ?? `Lesson ${index}`}
    </span>
    {words !== undefined && (
      <span class="text-xs font-medium text-slate-500 dark:text-ink-400 tabular-nums">{words.toLocaleString()} words</span>
    )}
  </div>
  <h3 class="mt-3 text-base font-semibold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-300 transition-colors leading-snug">
    {title}
  </h3>
  {description && (
    <p class="mt-2 text-sm text-slate-600 dark:text-ink-300 line-clamp-2 leading-relaxed">
      {description}
    </p>
  )}
  <div class={`mt-4 flex items-center text-sm font-semibold ${colors.text} transition-colors`}>
    Read lesson
    <svg class="ml-1 h-4 w-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
    </svg>
  </div>
</a>

