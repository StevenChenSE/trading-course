---
export interface Props {
  href: string;
  index: number;
  title: string;
  description?: string;
  badge?: string;
  badgeColor?: 'brand' | 'violet' | 'emerald' | 'amber';
  words?: number;
}

const { href, index, title, description, badge, badgeColor = 'brand', words } = Astro.props;

const colorMap = {
  brand: 'from-brand-500/20 to-brand-500/0 text-brand-300 ring-brand-500/30',
  violet: 'from-violet-500/20 to-violet-500/0 text-violet-300 ring-violet-500/30',
  emerald: 'from-emerald-500/20 to-emerald-500/0 text-emerald-300 ring-emerald-500/30',
  amber: 'from-amber-500/20 to-amber-500/0 text-amber-300 ring-amber-500/30',
};
---
<a
  href={href}
  class="group relative block rounded-2xl glass glass-hover p-6 transition-all hover:-translate-y-0.5 animate-fade-up"
  style={`animation-delay: ${index * 40}ms`}
>
  <div class={`absolute inset-x-0 top-0 h-px bg-gradient-to-r ${colorMap[badgeColor].split(' ').slice(0, 2).join(' ')}`}></div>
  <div class="flex items-start justify-between gap-3">
    <span class={`inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${colorMap[badgeColor].split(' ').slice(2).join(' ')} bg-gradient-to-r`}>
      {badge ?? `Lesson ${index}`}
    </span>
    {words !== undefined && (
      <span class="text-xs text-ink-500 tabular-nums">{words.toLocaleString()} words</span>
    )}
  </div>
  <h3 class="mt-3 text-base font-semibold text-white group-hover:text-brand-300 transition-colors leading-snug">
    {title}
  </h3>
  {description && (
    <p class="mt-2 text-sm text-ink-400 line-clamp-2 leading-relaxed">
      {description}
    </p>
  )}
  <div class="mt-4 flex items-center text-sm font-medium text-brand-400 group-hover:text-brand-300 transition-colors">
    Read lesson
    <svg class="ml-1 h-4 w-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
    </svg>
  </div>
</a>
