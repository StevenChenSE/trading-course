---
export interface Props {
  href: string;
  index: number;
  title: string;
  description?: string;
  badge?: string;
  badgeColor?: 'brand' | 'violet' | 'emerald' | 'amber';
  words?: number;
  readMinutes?: number;
}

const {
  href,
  index,
  title,
  description,
  badge,
  badgeColor = 'brand',
  words,
  readMinutes,
} = Astro.props;

const colorMap = {
  brand: {
    accent: 'text-brand-600 dark:text-brand-400',
    border: 'group-hover:border-slate-300 dark:group-hover:border-white/20',
  },
  violet: {
    accent: 'text-violet-600 dark:text-violet-400',
    border: 'group-hover:border-slate-300 dark:group-hover:border-white/20',
  },
  emerald: {
    accent: 'text-emerald-600 dark:text-emerald-400',
    border: 'group-hover:border-slate-300 dark:group-hover:border-white/20',
  },
  amber: {
    accent: 'text-amber-600 dark:text-amber-400',
    border: 'group-hover:border-slate-300 dark:group-hover:border-white/20',
  },
};

const colors = colorMap[badgeColor] || colorMap.brand;
const minutes = readMinutes ?? Math.max(1, Math.round((words ?? 0) / 230));
const date = 'Aug 2026';
---

<a
  href={href}
  class:list={[
    'group flex items-center gap-5 py-5 border-b border-slate-200/70 dark:border-white/5',
    'transition-colors',
  ]}
>
  <div class="hidden sm:flex flex-col items-center gap-1 w-14 shrink-0">
    <span class={`text-[11px] font-bold uppercase tracking-[0.16em] ${colors.accent}`}>
      {badge ?? `Lesson ${index}`}
    </span>
    <span class="text-[11px] font-medium text-slate-400 dark:text-ink-500 tabular-nums">
      {String(index).padStart(2, '0')}
    </span>
  </div>

  <div class="flex-1 min-w-0">
    <h3
      class="font-display text-[1.25rem] font-bold tracking-[-0.012em] text-slate-900 dark:text-white leading-snug group-hover:text-brand-600 dark:group-hover:text-brand-300 transition-colors"
    >
      {title}
    </h3>
    {
      description && (
        <p class="mt-1 font-serif text-[15px] text-slate-600 dark:text-ink-300 line-clamp-2 leading-[1.55]">
          {description}
        </p>
      )
    }
    <div class="byline mt-2 !text-xs">
      <span
        class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-slate-700 text-white text-[10px] font-semibold"
        >SC</span
      >
      <span class="font-semibold text-slate-700 dark:text-ink-200">Steven Chen</span>
      <span class="text-slate-400 dark:text-ink-500">·</span>
      <span>{date}</span>
      <span class="text-slate-400 dark:text-ink-500">·</span>
      <span>{minutes} min read</span>
      {
        words !== undefined && (
          <>
            <span class="text-slate-400 dark:text-ink-500">·</span>
            <span class="tabular-nums">{words.toLocaleString()} words</span>
          </>
        )
      }
    </div>
  </div>

  <span
    class={`hidden sm:inline-flex items-center text-sm font-semibold ${colors.accent} opacity-0 group-hover:opacity-100 transition-opacity`}
  >
    Read →
  </span>
</a>
