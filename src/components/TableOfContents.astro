---
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}
export interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{
  (() => {
    if (items.length === 0) return null;
    return (
      <>
        <!-- Mobile Collapsible TOC -->
        <details class="xl:hidden my-6 rounded-2xl glass p-4 text-sm">
          <summary class="flex items-center justify-between cursor-pointer font-semibold text-slate-800 dark:text-ink-200 select-none">
            <span class="inline-flex items-center gap-2">
              <svg class="h-4 w-4 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="8" y1="6" x2="21" y2="6" />
                <line x1="8" y1="12" x2="21" y2="12" />
                <line x1="8" y1="18" x2="21" y2="18" />
                <line x1="3" y1="6" x2="3.01" y2="6" />
                <line x1="3" y1="12" x2="3.01" y2="12" />
                <line x1="3" y1="18" x2="3.01" y2="18" />
              </svg>
              Table of Contents ({items.length} sections)
            </span>
            <svg class="h-4 w-4 text-slate-400 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <ul class="mt-3 space-y-2 pt-3 border-t border-slate-200/60 dark:border-white/5 pl-2">
            {items.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class:list={[
                    'block text-xs leading-snug text-slate-600 dark:text-ink-300 hover:text-brand-600 dark:hover:text-white transition-colors',
                    h.depth === 3 ? 'pl-3 border-l border-slate-200 dark:border-white/10' : 'font-medium',
                  ]}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop Sticky TOC */}
        <nav class="hidden xl:block" aria-label="On this page">
          <div class="sticky top-24 max-h-[calc(100vh-6rem)] overflow-y-auto no-scrollbar pl-4 border-l border-slate-200 dark:border-white/5">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-ink-400 mb-3">On this page</h4>
            <ul class="space-y-2.5 text-sm">
              {items.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link={h.slug}
                    class:list={[
                      'block leading-snug transition-colors',
                      h.depth === 3 ? 'pl-4 text-xs' : 'font-medium',
                      'text-slate-500 dark:text-ink-400 hover:text-slate-900 dark:hover:text-white',
                    ]}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      </>
    );
  })()
}

<script>
  function initTOC() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const slug = (entry.target as HTMLElement).id;
          if (!slug) return;
          const link = document.querySelector(`[data-toc-link="${slug}"]`);
          if (entry.isIntersecting) {
            document.querySelectorAll('[data-toc-link]').forEach((el) =>
              el.classList.remove('text-brand-600', 'dark:text-brand-300', 'font-semibold', 'translate-x-1')
            );
            link?.classList.add('text-brand-600', 'dark:text-brand-300', 'font-semibold');
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    document.querySelectorAll('.prose h2, .prose h3').forEach((el) => observer.observe(el));
  }

  document.addEventListener('astro:page-load', initTOC);
  initTOC();
</script>

