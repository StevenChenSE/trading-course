---
// Theme toggle - works with Astro view transitions.
---

<button
  type="button"
  id="theme-toggle"
  aria-label="Toggle theme"
  class="inline-flex items-center justify-center rounded-lg p-2 text-slate-600 dark:text-ink-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors"
>
  <svg
    class="h-5 w-5 hidden dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    class="h-5 w-5 block dark:hidden text-amber-500"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'theme';

    function applyStoredTheme() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        // Default is light; dark mode is opt-in.
        document.documentElement.classList.toggle('dark', stored === 'dark');
      } catch {}
    }

    function bindToggle() {
      const btn = document.getElementById('theme-toggle');
      if (!btn || btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem(STORAGE_KEY, isDark ? 'dark' : 'light');
        } catch {}
      });
    }

    // Re-apply saved theme and re-bind the click handler on every navigation,
    // whether it's the first paint or a view-transition swap.
    document.addEventListener('astro:page-load', () => {
      applyStoredTheme();
      bindToggle();
    });

    // For view transitions, also re-apply before the swap so the new <html>
    // carries the saved theme into the painted frame.
    document.addEventListener('astro:after-swap', () => {
      applyStoredTheme();
      bindToggle();
    });
  })();
</script>
